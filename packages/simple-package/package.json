{
  "name": "@feugene/simple-package",
  "description": "Reference GranularProvider package for @feugene/unocss-preset-granular: base Vue 3 components that exercise the contract (scanning layout, component CSS, theme token refs, shared-chunk groups).",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Evgeniy Fureev",
    "url": "https://github.com/efureev"
  },
  "homepage": "https://github.com/efureev/unocss-preset-granular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efureev/unocss-preset-granular.git",
    "directory": "packages/simple-package"
  },
  "bugs": {
    "url": "https://github.com/efureev/unocss-preset-granular/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "granular",
    "granular-provider",
    "unocss",
    "unocss-preset",
    "design-system",
    "tree-shakeable"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "types": "./dist/types/src/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/XTest1": {
      "types": "./dist/types/src/components/XTest1/index.d.ts",
      "import": "./dist/components/XTest1/index.js"
    },
    "./components/XTestStyled": {
      "types": "./dist/types/src/components/XTestStyled/index.d.ts",
      "import": "./dist/components/XTestStyled/index.js"
    },
    "./components/XTokenized": {
      "types": "./dist/types/src/components/XTokenized/index.d.ts",
      "import": "./dist/components/XTokenized/index.js"
    },
    "./components/XNested": {
      "types": "./dist/types/src/components/XNested/index.d.ts",
      "import": "./dist/components/XNested/index.js"
    },
    "./components/XNestedReverse": {
      "types": "./dist/types/src/components/reverses/XNestedReverse/index.d.ts",
      "import": "./dist/components/XNestedReverse/index.js"
    },
    "./components/XGroupAOne": {
      "types": "./dist/types/src/components/groupA/XGroupAOne/index.d.ts",
      "import": "./dist/components/XGroupAOne/index.js"
    },
    "./components/XGroupATwo": {
      "types": "./dist/types/src/components/groupA/XGroupATwo/index.d.ts",
      "import": "./dist/components/XGroupATwo/index.js"
    },
    "./granular-provider": {
      "types": "./dist/types/src/granular-provider/index.d.ts",
      "import": "./dist/granular-provider.js",
      "default": "./dist/granular-provider.js"
    },
    "./granular-provider/node": {
      "types": "./dist/types/src/granular-provider/node.d.ts",
      "import": "./dist/granular-provider-node.js",
      "default": "./dist/granular-provider-node.js"
    }
  },
  "peerDependencies": {
    "@feugene/unocss-preset-granular": "^0.8.2",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@feugene/unocss-preset-granular": "^0.8.2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  }
}
