{
  "name": "@feugene/extra-simple-package",
  "description": "Reference composite GranularProvider for @feugene/unocss-preset-granular: components that depend on @feugene/simple-package and pull it in transitively via provider dependencies.",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Evgeniy Fureev",
    "url": "https://github.com/efureev"
  },
  "homepage": "https://github.com/efureev/unocss-preset-granular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efureev/unocss-preset-granular.git",
    "directory": "packages/extra-simple-package"
  },
  "bugs": {
    "url": "https://github.com/efureev/unocss-preset-granular/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "granular",
    "granular-provider",
    "unocss",
    "unocss-preset",
    "design-system",
    "composite-components",
    "tree-shakeable"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "types": "./dist/types/src/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/XgQuick": {
      "types": "./dist/types/src/components/XgQuick/index.d.ts",
      "import": "./dist/components/XgQuick/index.js"
    },
    "./components/XTokenizedLevel2": {
      "types": "./dist/types/src/components/XTokenizedLevel2/index.d.ts",
      "import": "./dist/components/XTokenizedLevel2/index.js"
    },
    "./granular-provider": {
      "types": "./dist/types/src/granular-provider/index.d.ts",
      "import": "./dist/granular-provider.js",
      "default": "./dist/granular-provider.js"
    },
    "./granular-provider/node": {
      "types": "./dist/types/src/granular-provider/node.d.ts",
      "import": "./dist/granular-provider-node.js",
      "default": "./dist/granular-provider-node.js"
    }
  },
  "peerDependencies": {
    "@feugene/simple-package": "^0.1.0",
    "@feugene/unocss-preset-granular": "^0.7.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@feugene/simple-package": "^0.1.0",
    "@feugene/unocss-preset-granular": "^0.7.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  }
}
