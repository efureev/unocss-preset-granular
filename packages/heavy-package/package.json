{
  "name": "@feugene/heavy-package",
  "description": "Fixture GranularProvider package with a full design-system foundation (tokens.css, base.css, light/dark themes) for measuring and pruning unused CSS tokens.",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Evgeniy Fureev",
    "url": "https://github.com/efureev"
  },
  "homepage": "https://github.com/efureev/unocss-preset-granular",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efureev/unocss-preset-granular.git",
    "directory": "packages/heavy-package"
  },
  "bugs": {
    "url": "https://github.com/efureev/unocss-preset-granular/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "granular",
    "granular-provider",
    "unocss",
    "design-system",
    "fixture"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "types": "./dist/types/src/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/XhCard": {
      "types": "./dist/types/src/components/XhCard/index.d.ts",
      "import": "./dist/components/XhCard/index.js"
    },
    "./components/XhButton": {
      "types": "./dist/types/src/components/XhButton/index.d.ts",
      "import": "./dist/components/XhButton/index.js"
    },
    "./components/XhAlert": {
      "types": "./dist/types/src/components/XhAlert/index.d.ts",
      "import": "./dist/components/XhAlert/index.js"
    },
    "./components/XhOverlay": {
      "types": "./dist/types/src/components/XhOverlay/index.d.ts",
      "import": "./dist/components/XhOverlay/index.js"
    },
    "./components/XhPanel": {
      "types": "./dist/types/src/components/XhPanel/index.d.ts",
      "import": "./dist/components/XhPanel/index.js"
    },
    "./components/XhTable": {
      "types": "./dist/types/src/components/data/XhTable/index.d.ts",
      "import": "./dist/components/XhTable/index.js"
    },
    "./components/XhList": {
      "types": "./dist/types/src/components/data/XhList/index.d.ts",
      "import": "./dist/components/XhList/index.js"
    },
    "./granular-provider": {
      "types": "./dist/types/src/granular-provider/index.d.ts",
      "import": "./dist/granular-provider.js",
      "default": "./dist/granular-provider.js"
    },
    "./granular-provider/node": {
      "types": "./dist/types/src/granular-provider/node.d.ts",
      "import": "./dist/granular-provider-node.js",
      "default": "./dist/granular-provider-node.js"
    }
  },
  "peerDependencies": {
    "@feugene/unocss-preset-granular": "^0.16.0",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@feugene/unocss-preset-granular": "^0.16.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.7"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  }
}
