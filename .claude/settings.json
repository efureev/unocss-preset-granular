{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn test)",
      "Bash(yarn test:granular)",
      "Bash(yarn build:granular)",
      "Bash(yarn build:unocss-mini-extra-rules)",
      "Bash(yarn build:packages)",
      "Bash(yarn build:apps)",
      "Bash(yarn build:all)",
      "Bash(yarn workspace * typecheck)",
      "Bash(yarn workspace * build)",
      "Bash(npx vitest run:*)",
      "Bash(npx tsc -p:*)",
      "Bash(npx vite build:*)",
      "Bash(npx --yes publint@latest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git tag)",
      "Bash(git check-ignore:*)",
      "Bash(git ls-files:*)"
    ]
  }
}
